{
  "architecture": {
    "stack": [
      "PA internal tracking / community system (operational source of truth)",
      "Data / database layer",
      "API / data services (approved public payloads only)",
      "Public PA website (this frontend)"
    ],
    "principle": "The website consumes only data intentionally approved for public display. Operational systems remain separate from editorial content."
  },
  "roles": {
    "contentOwner": "Communications / Knowledge Hub",
    "publisher": "Website editors (CMS when connected)",
    "approver": "PA leadership — public indicators & community detail level",
    "dataSteward": "Monitoring & Evaluation / field systems"
  },
  "editorialSources": [
    "stories",
    "reports",
    "newsUpdates",
    "knowledgeHub",
    "aboutPa",
    "ourWork",
    "whereWeWork",
    "ministryModel",
    "home"
  ],
