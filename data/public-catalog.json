  "cms": {
    "status": "planned",
    "scope": "Editorial website content — stories, news, pages, reports, and resources",
    "note": "Operational tracking data stays in PA internal systems; CMS publishes approved editorial content only."
  },
  "adminAccess": {
    "status": "planned",
    "model": "Role-based access (contentOwner, publisher, approver, dataSteward)",
    "note": "Any future editorial/admin area must require authenticated roles; the public site remains read-only."
  },
  "frontendPrinciples": [
    "Mobile-first layouts",
    "Low-data usage (lazy images, deferred maps/charts)",
    "Reusable components for country pages, community profiles, indicators, charts, and stories",
    "SEO foundations (title/description/OG/JSON-LD, robots, sitemap)",
    "Log public data load times and failures — never silently show broken or incomplete sources"
  ]
